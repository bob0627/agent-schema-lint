{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "oldText": {
            "type": "string",
            "description": "Text to search for - must match exactly"
          },
          "newText": {
            "type": "string",
            "description": "Text to replace with"
          }
        },
        "required": [
          "oldText",
          "newText"
        ]
      }
    },
    "dryRun": {
      "default": false,
      "description": "Preview changes using git-style diff format",
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "edits"
  ]
}